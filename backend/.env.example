# Copy to .env for local development only. In production, secrets come from Secret Manager.
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
CHAIN_ID=yaw-testnet-1

# Generate with: npm run gen-key   (never commit a real key)
OPERATOR_PRIVATE_KEY=

# Optional: address that receives fees (defaults to the operator address)
# FEE_RECIPIENT=yaw...
MIN_FEE=0
MAX_TX_PER_BLOCK=50

# true  = every accepted transaction triggers a block attempt (testnet convenience)
# false = blocks are produced only via POST /internal/produce-block (Cloud Scheduler)
INSTANT_BLOCKS=true

# At least 32 characters. Leave unset to disable /internal/* completely.
# PRODUCER_TOKEN=

# JSON object address -> amount in base units (1 YAW = 1000000). Only read when the chain is first created.
GENESIS_ALLOCATIONS={}

# Comma separated browser origins allowed to call the API. Empty = no CORS.
CORS_ORIGINS=
